[Unit]
Description=Keep {{PROJECT_NAME}} running and contactable
After=pi-network-genie-{{PROJECT_NAME}}.service
Requires=pi-network-genie-{{PROJECT_NAME}}.service

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{INSTALL_PATH}}
ExecStart={{SERVICE_COMMAND}}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
